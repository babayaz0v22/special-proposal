# Telegram Bot Configuration (Required for notifications)
# Create a bot with @BotFather on Telegram and paste the token here:
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Your Telegram Chat ID (Required)
# Get your ID from @userinfobot or @myidbot on Telegram:
TELEGRAM_CHAT_ID="123456789"

# One-time Access Mode Configuration:
# 1. Zero-setup mode (Default): You can define pre-approved tokens here separated by commas.
# When a user completes the proposal, their token is marked as consumed.
APP_ACCESS_TOKENS="nodirbek,special,proposal,love"

# 2. Upstash Redis Mode (Optional - for distributed, multi-device invalidation):
# Get these free credentials from https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
